# Copy to .env.local and fill in. Never commit .env.local.
#
# An OpenRouter API key is separate from any chat subscription (Claude, ChatGPT,
# ...). Create one at https://openrouter.ai/keys and add credits to the account.
OPENROUTER_API_KEY=

# Optional: use the clearly-labelled mock provider (no network, no cost).
# Also toggleable in the UI.
# MOCK_MODE=1

# Optional tuning
# MAX_UPLOAD_MB=10
# POLL_INTERVAL_MS=15000
# DATA_DIR=./data

# Optional: extra hostnames allowed to open the dev server (comma-separated,
# no scheme/port). 192.168.*.* is already allowed.
# ALLOWED_DEV_ORIGINS=my-laptop.local,10.0.0.*
